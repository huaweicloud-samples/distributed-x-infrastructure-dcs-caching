# 运行环境示例 — 直接连接（无 SSH 隧道）

# RDS for PostgreSQL / GeminiDB 兼容 endpoint（占位符，替换为实际内网地址）
DB_HOST=<rds-endpoint>
DB_PORT=5432
DB_NAME=testdb
DB_USER=dbadmin
DB_PASSWORD=TempPassword12345

# DCS Redis — direct endpoint (no TLS, within VPC)
CACHE_ENDPOINT=<dcs-endpoint>:6379
CACHE_USE_SSL=false
CACHE_NAME=
CACHE_IAM_REGION=cn-north-4
